# auto uses OpenAI when its key is present, otherwise Anthropic.
# Set openai or anthropic to explicitly select a provider.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Optional OpenAI overrides; blank uses OPENAI_MODEL.
OPENAI_VISION_MODEL=
OPENAI_REDESIGN_MODEL=

# Existing Anthropic configuration remains supported.
ANTHROPIC_API_KEY=
VLM_MODEL=claude-sonnet-4-6
REDESIGN_MODEL=

# Set to 1 to force offline analysis and disable website generation.
VIBE_MOCK=0
